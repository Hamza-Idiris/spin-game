# ---------- Frontend (frontend/.env) — public values only ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------- Edge Function secrets (set with `supabase secrets set`, NEVER in the frontend) ----------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
ALLOWED_ORIGINS=https://your-site.vercel.app           # comma separated; use * only for local testing
CRON_SECRET=generate-a-long-random-string               # must equal the vault secret 'cron_secret'
BACKUP_ENCRYPTION_KEY=base64-of-32-random-bytes         # openssl rand -base64 32
# Optional failure e-mails (https://resend.com)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
NOTIFY_FROM=SPIN <alerts@yourdomain.com>
